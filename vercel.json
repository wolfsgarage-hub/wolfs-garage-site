{
  "redirects": [
    {"source":"/post-maker","destination":"https://raw.githack.com/wolfsgarage-hub/Wolfs-admin/main/index.html?tab=studio&v=39.0.0","permanent":false},
    {"source":"/social-queue","destination":"https://raw.githack.com/wolfsgarage-hub/Wolfs-admin/main/social-queue.html?v=1.2.0","permanent":false},
    {
      "source": "/pages/hot-rodder-directory",
      "destination": "/directory",
      "permanent": true
    },
    {
      "source": "/pages/hot-rodder-directory/(.*)",
      "destination": "/directory/$1",
      "permanent": true
    },
    {
      "source": "/pack",
      "destination": "/directory",
      "permanent": false
    },
    {
      "source": "/pages/join-the-list",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/directory/",
      "destination": "/directory",
      "permanent": true
    },
    {
      "source": "/get-listed.html",
      "destination": "/directory/get-listed.html",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/directory", "destination": "https://wolfs-garage-community.vercel.app/" },
    { "source": "/directory/:path*", "destination": "https://wolfs-garage-community.vercel.app/:path*" },
    { "source": "/events", "destination": "/events.html" },
    { "source": "/events/", "destination": "/events.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/events/:slug", "destination": "/api/event-page?slug=:slug" },
    { "source": "/sitemap-events.xml", "destination": "/api/sitemap-events" }
  ],
  "headers": [
    {"source":"/post-maker","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow"}]},
    {"source":"/social-queue","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow"}]},
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
